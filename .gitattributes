# Normalización de fines de línea.
# Sin esto, un archivo tocado en dos máquinas distintas (Windows con CRLF, Linux o Mac con LF)
# aparece como "cambiado entero" y genera conflictos falsos en cada merge hacia development.
#
# Cómo funciona: en el repositorio todo se guarda con LF. Al hacer checkout, cada máquina
# recibe el formato nativo de su sistema.

* text=auto

# ===== Código fuente y configuración =====
*.js        text
*.jsx       text
*.mjs       text
*.css       text
*.html      text
*.json      text
*.md        text
*.yml       text
*.yaml      text
*.svg       text
.gitignore      text
.gitattributes  text
.prettierrc     text

# ===== Scripts: el fin de línea importa para que se ejecuten =====
*.sh        text eol=lf
*.ps1       text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf

# ===== Binarios: que Git no los toque nunca =====
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.woff      binary
*.woff2     binary
*.pdf       binary
*.zip       binary

# ===== Archivos generados: GitHub los colapsa en el diff de los PR =====
package-lock.json   linguist-generated=true
